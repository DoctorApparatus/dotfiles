bt_active_json() {
    local active_line tab_id full_entry id title url current_date
    active_line=$(bt active 2>/dev/null)
    [[ -z "$active_line" ]] && { echo '{"error": "No active tab found"}' >&2; return 1; }
    
    tab_id=$(echo "$active_line" | awk '{print $1}')
    full_entry=$(bt list 2>/dev/null | grep "^$tab_id\b")
    [[ -z "$full_entry" ]] && full_entry="$active_line"

    id=$(echo "$full_entry" | awk -F'\t' '{print $1}')
    title=$(echo "$full_entry" | awk -F'\t' '{print $2}')
    url=$(echo "$full_entry" | awk -F'\t' '{print $3}')
    current_date=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    python3 -c 'import json, sys; print(json.dumps({"id": sys.argv[1], "title": sys.argv[2], "url": sys.argv[3], "date": sys.argv[4]}, indent=2))' "$id" "$title" "$url" "$current_date"
}

bt_active_json_save() {
    local active_line tab_id full_entry id title url current_date filename
    active_line=$(bt active 2>/dev/null)
    [[ -z "$active_line" ]] && { echo '{"error": "No active tab found"}' >&2; return 1; }
    
    tab_id=$(echo "$active_line" | awk '{print $1}')
    full_entry=$(bt list 2>/dev/null | grep "^$tab_id\b")
    [[ -z "$full_entry" ]] && full_entry="$active_line"

    id=$(echo "$full_entry" | awk -F'\t' '{print $1}')
    title=$(echo "$full_entry" | awk -F'\t' '{print $2}')
    url=$(echo "$full_entry" | awk -F'\t' '{print $3}')
    current_date=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    filename=$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g' | sed -E 's/^_|_$//g')

    python3 -c 'import json, sys; print(json.dumps({"id": sys.argv[1], "title": sys.argv[2], "url": sys.argv[3], "date": sys.argv[4]}, indent=2))' "$id" "$title" "$url" "$current_date"  > ~/saved_tabs/"$filename".json
}

