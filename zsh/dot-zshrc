#
# Github Downloader
#
function fetch_github_assets() {
	local repo=$1        # Format: "owner/repo"
	echo "REPO: [$repo]"
	local file_pattern=$2 # Extension or keyword (e.g., ".zip", "linux-amd64")
	echo "FILE_PATTERN: [$FILE_PATTERN]"

	if [[ -z "$repo" || -z "$file_pattern" ]]; then
	echo "Usage: fetch_github_assets 'owner/repo' 'file_pattern'"
		return 1
	fi

	echo "Checking latest release for $repo..."
	local release_json
	release_json="$(curl -L \
	  -H "Accept: application/vnd.github+json" \
	  -H "Authorization: Bearer $GITHUB_API_KEY" \
	  -H "X-GitHub-Api-Version: 2022-11-28" \
	  https://api.github.com/repos/$repo/releases)"

	echo "$release_json" | jq
	exit 0

	# 2. Check for errors (like 404 or rate limiting)
	if echo "$release_json" | jq -e '.message' > /dev/null; then
		echo "Error: $(echo "$release_json" | jq -r '.message')"
		return 1
	fi

	local download_url
	download_url=$(echo "$release_json" | jq -r ".assets[] | select(.name | contains(\"$file_pattern\")) | .browser_download_url" | head -n 1)

    if [[ -z "$download_url" || "$download_url" == "null" ]]; then
        echo "No asset found matching: $file_pattern"
        return 1
    fi

    # 4. Download the file
    echo "Downloading: $(basename "$download_url")"
    curl -L -O "$download_url"
}


